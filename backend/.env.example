# ─── Application ───────────────────────────────────────────────
APP_NAME="Autonomous AI Market Research Agent"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Security ──────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-secret-string-at-least-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market_research
DB_ECHO=false

# ─── Google Gemini ─────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TEMPERATURE=0.2

# ─── Tavily Search ─────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here
TAVILY_MAX_RESULTS=10
TAVILY_SEARCH_DEPTH=advanced

# ─── Playwright ────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_MAX_CONCURRENT=5

# ─── Redis / Celery ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@marketresearch.ai
SMTP_USE_TLS=true

# ─── Research Defaults ─────────────────────────────────────────
MAX_COMPETITORS=5
MAX_ARTICLES_PER_COMPETITOR=10
MAX_RESEARCH_DURATION_MINUTES=15
EMBEDDING_DIMENSION=768

# ─── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ─── Sentiment Agent ───────────────────────────────────────────
SENTIMENT_ENABLED=true

# ─── Chat / RAG ────────────────────────────────────────────────
CHAT_MAX_CONTEXT_TOKENS=8000
CHAT_MAX_HISTORY=20

# ─── Scheduled Runs ────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=300

# ─── Change Detection ──────────────────────────────────────────
DIFF_SIGNIFICANCE_THRESHOLD=6

# ─── One-Pager ─────────────────────────────────────────────────
ONEPAGER_MAX_WORDS=250

# ─── Financial Intelligence ────────────────────────────────────
CRUNCHBASE_API_KEY=
FINANCIAL_DATA_PROVIDER=tavily